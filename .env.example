# Database (PostgreSQL 16+ with btree_gist extension)
# On Neon + Vercel: set DATABASE_URL to the pooled URL (-pooler) and DIRECT_URL to the direct URL.
DATABASE_URL="postgresql://user:password@localhost:5432/trchr_dev?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/trchr_dev?schema=public"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/trchr_test?schema=public"

# Better Auth & App Origin
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
APP_ORIGIN="http://localhost:3000"

# QR credential signing keyring (HS256, JSON object mapping kid -> secret >= 32 chars)
QR_SIGNING_KEYS_JSON='{"k1":"replace-with-at-least-32-char-qr-signing-secret"}'
QR_ACTIVE_KID="k1"
QR_ISSUER="trchr:office"
QR_AUDIENCE="trchr:attendance"

# Pure Node.js SMTP email delivery via nodemailer (leave SMTP_HOST blank in dev for console preview)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Top Realty Attendance <no-reply@toprealty.local>"
SMTP_SECURITY="starttls"

# Vercel Cron secret for /api/v1/cron/worker (at least 16 random chars)
CRON_SECRET=""

# TypeSafe Jev (advisory review worker; omit key or set JEV_MODE=stub for dev stub)
TYPESAFE_JEV_API_KEY=""
JEV_MODE="auto"
JEV_MODEL_VERSION="jev-1.13.0"
JEV_CRITERIA_VERSION="2026-10-v1"

# Bootstrap seed inputs (used only by npx tsx prisma/seed.ts)
BOOTSTRAP_HR_EMAIL="hr@toprealty.local"
BOOTSTRAP_HR_PASSWORD="replace-with-strong-password"
BOOTSTRAP_HR_NAME="Top Realty HR"
BOOTSTRAP_OFFICE_NAME="Top Realty Main Office"
BOOTSTRAP_OFFICE_LAT="14.554729"
BOOTSTRAP_OFFICE_LNG="121.024445"
BOOTSTRAP_OFFICE_TZ="Asia/Manila"
BOOTSTRAP_OFFICE_RADIUS_METERS="60"
BOOTSTRAP_OFFICE_MAX_ACCURACY_METERS="25"
BOOTSTRAP_DEPARTMENTS="Marketing,Sales,Operations,Finance"

# Optional UI fixture/mock mode (leave unset/0 for real PostgreSQL backend)
USE_MOCK_APIS="0"

# Runtime
PORT=3000
